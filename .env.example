# Copy to .env and export before running. Keep real values out of git.
# Optional SMTP sending (default is Gmail web driven by Playwright, no password needed)
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Path to a Chrome/Chromium binary used for headless demo screenshots
CHROME_BIN=
# Only for i18n/translate.py (generating new language packs)
LLM_API_KEY=
